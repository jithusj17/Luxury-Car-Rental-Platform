# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env and fill in.
# Never commit deploy/.env.

# --- Site ---
DOMAIN=carrental.example.com
PUBLIC_URL=https://carrental.example.com
# Long random strings (e.g. `openssl rand -hex 32`)
POSTGRES_PASSWORD=change-me
METRICS_TOKEN=change-me-to-a-long-random-token
# Comma-separated emails that become admins once they register and verify their email.
ADMIN_EMAILS=you@example.com

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook endpoint: https://carrental.example.com/api/v1/payments/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email over SMTP (Resend, SendGrid, Amazon SES, Postmark, Mailgun…) ---
SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_FROM="Car Rental <no-reply@carrental.example.com>"

# --- Photo storage: any S3-compatible bucket with public read (AWS S3, Cloudflare R2…) ---
S3_BUCKET=car-rental-photos
S3_REGION=auto
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_FORCE_PATH_STYLE=false
# Public URL of the bucket (or its CDN / custom domain), without a trailing slash
STORAGE_PUBLIC_URL=https://photos.carrental.example.com
# Same host for the web app's image optimiser (baked in at build time)
IMAGE_REMOTE_PATTERNS=https://photos.carrental.example.com/vehicles/**
