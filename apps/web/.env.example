# Server-side URL of the API (used by Next.js server components and the /api rewrite).
API_INTERNAL_URL=http://localhost:4000

# Where vehicle photos are served from (comma-separated URL patterns).
# Local development: the API serves uploads. Production: your S3/R2 public URL, e.g. https://photos.example.com/vehicles/**
IMAGE_REMOTE_PATTERNS=http://localhost:4000/uploads/**
# Local development only: lets Next.js optimise images served from localhost. Never set in production.
IMAGES_ALLOW_LOCAL_IP=true

# Stripe publishable key (pk_test_… / pk_live_…), needed when the API uses PAYMENT_PROVIDER=stripe.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
