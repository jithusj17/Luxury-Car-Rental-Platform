# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5433/carrental
DATABASE_POOL_MAX=10
# Optional locally; required for consistent rate limits across several production instances.
REDIS_URL=redis://localhost:6380
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
SESSION_TTL_DAYS=14
BOOKING_HOLD_MINUTES=15
PAYMENT_PROVIDER=mock
# 16+ random characters; must match the provider's webhook signing secret.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
PUBLIC_API_URL=http://localhost:4000
JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
# Required in production: bearer token for GET /metrics
# METRICS_TOKEN=
