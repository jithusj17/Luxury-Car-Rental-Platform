# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5433/carrental
DATABASE_POOL_MAX=10
# Optional locally; required for consistent rate limits across several production instances.
REDIS_URL=redis://localhost:6380
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
SESSION_TTL_DAYS=14
BOOKING_HOLD_MINUTES=15
# Payments: "mock" (built-in test provider, development only) or "stripe".
PAYMENT_PROVIDER=mock
# Mock provider signing secret (16+ characters).
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Stripe (PAYMENT_PROVIDER=stripe): secret key and the signing secret of the webhook endpoint
# https://<your-api>/v1/payments/webhooks/stripe (events: payment_intent.succeeded, .payment_failed, .canceled)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_API_URL=http://localhost:4000
# Email: "log" prints emails to the console; "smtp" sends them.
# Local inbox (docker compose): smtp://localhost:1025, view at http://localhost:8025
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Car Rental <no-reply@carrental.local>"
JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
# Required in production: bearer token for GET /metrics
# METRICS_TOKEN=
